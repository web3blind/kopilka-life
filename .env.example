NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
WEBAPP_URL=http://localhost:3000
BOT_TOKEN=replace_me
BOT_USERNAME=replace_me
# Secret sent by Telegram in X-Telegram-Bot-Api-Secret-Token for every webhook update.
# Production rejects public placeholders and secrets shorter than 16 characters.
# Generate independent random SESSION_SECRET and TELEGRAM_WEBHOOK_SECRET (32+ recommended).
# Existing non-placeholder secrets >=16 characters remain accepted; no automatic rotation.
TELEGRAM_WEBHOOK_SECRET=replace_with_32_or_more_random_characters
# Telegram Login Widget requires BotFather /setdomain for the site host.
TELEGRAM_LOGIN_WIDGET_ENABLED=false
VK_APP_ID=54723764
VK_SECURE_KEY=replace_me
# Separate VK ID OAuth app for website sign-in/linking (not the Mini App id).
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=
VK_AUTH_MAX_AGE_SECONDS=604800
DB_PATH=./data/kopilka-life.sqlite
# MaxMind GeoLite2/GeoIP2 Country MMDB on the server; unknown IP uses RU-safe website options.
GEO_COUNTRY_DB_PATH=
# Resend API: verify blinddev.xyz first. Sender address does not require a hosted mailbox.
RESEND_API_KEY=
EMAIL_FROM=noreply@blinddev.xyz
EMAIL_REPLY_TO=contact@blinddev.xyz
# Separate Google Cloud OAuth Web client; redirect https://life.blinddev.xyz/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Web Push for authenticated browsers (HTTPS/localhost; generate on protected deploy).
# VAPID_PUBLIC_KEY is public; private key stays in protected .env, never source control.
# Generate one stable pair in a protected deployment session; do not print or commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.invalid
SESSION_SECRET=change_me_dev
SESSION_MAX_AGE_SECONDS=31536000
DEV_AUTH_ENABLED=true
SCHEDULER_ENABLED=true
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=200
RATE_LIMIT_STORY_WINDOW_MS=60000
RATE_LIMIT_STORY_MAX=12
RATE_LIMIT_DEV_WINDOW_MS=60000
RATE_LIMIT_DEV_MAX=200
RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
RATE_LIMIT_WEBHOOK_MAX=1000
